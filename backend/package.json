{
  "name": "education-backend",
  "version": "1.0.0",
  "description": "Backend API for Education Management System",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "seed": "tsx src/database/seeders/seed.ts",
    "gen:types": "tsx scripts/collect-schema-types.ts",
